# Copy to .env (git-ignored) and fill in. Never commit the real .env.
# Names are provider-neutral; LLM_PROVIDER picks the adapter in app/llm.py.

# Which upstream adapter to use (currently supported: anthropic)
LLM_PROVIDER=anthropic

# Upstream API key (KodeKloud KodeKey, or an Anthropic key)
LLM_API_KEY=replace-me

# Upstream URL. KodeKey: https://api.ai.kodekloud.com (no /v1). Leave empty for Anthropic direct.
LLM_BASE_URL=https://api.ai.kodekloud.com

# Model id the gateway calls
LLM_MODEL=claude-sonnet-5-5

# Postgres (block 6), matches docker compose later
# DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway
