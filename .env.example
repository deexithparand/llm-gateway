# Copy to .env (git-ignored) and fill in. Never commit the real .env.

# Anthropic API key (console.anthropic.com, or your KodeKey)
ANTHROPIC_API_KEY=sk-ant-replace-me

# Only if your key comes from a proxy (e.g. KodeKey) that gives you its own URL
# ANTHROPIC_BASE_URL=

# Model the gateway calls
CLAUDE_MODEL=claude-opus-5-5

# Postgres (block 6), matches docker compose later
# DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway
